<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Low Light Warning Overlay -->
    <LinearLayout
        android:id="@+id/lowLightWarningOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/lowLightWarningIcon"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/warning_header"
            android:layout_marginBottom="24dp"
            android:contentDescription="Warning" />

        <TextView
            android:id="@+id/lowLightWarningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low\nLighting"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/lowLightWarningSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detection accuracy may be reduced"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Obstruction Warning Overlay -->
    <LinearLayout
        android:id="@+id/obstructionWarningOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/obstructionWarningIcon"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/warning_header"
            android:layout_marginBottom="24dp"
            android:contentDescription="Warning" />

        <TextView
            android:id="@+id/obstructionWarningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMERA\nOBSCURED"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/obstructionWarningSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detection accuracy may be reduced"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Battery Warning Overlay -->
    <LinearLayout
        android:id="@+id/batteryWarningOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/batteryWarningIcon"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/warning_header"
            android:layout_marginBottom="24dp"
            android:contentDescription="Warning" />

        <TextView
            android:id="@+id/batteryWarningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOW BATTERY\nPERCENTAGE"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/batteryWarningSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please connect to a power source\nto ensure continuous navigation."
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- ═══ Goodbye Overlay (initially hidden) ═══ -->
    <FrameLayout
        android:id="@+id/goodbye_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:alpha="0"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Full-screen close background image -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/close_background"
            android:scaleType="centerCrop"
            android:contentDescription="Close Background" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="60dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Glow behind logo (purple) -->
            <RelativeLayout
                android:layout_width="200dp"
                android:layout_height="200dp">

                <View
                    android:id="@+id/goodbye_glow"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/glow_effect_purple"
                    android:alpha="0" />

                <ImageView
                    android:id="@+id/goodbye_logo"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/iris_logo"
                    android:contentDescription="IRIS Logo"
                    android:alpha="0" />

            </RelativeLayout>

            <!-- Goodbye Title -->
            <TextView
                android:id="@+id/goodbye_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Goodbye"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:alpha="0" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/goodbye_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="IRIS is closing."
                android:textColor="#99FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-light"
                android:alpha="0" />

        </LinearLayout>

    </FrameLayout>

    <!-- Status Dashboard Container (Dynamically Inflated) -->
    <FrameLayout
        android:id="@+id/status_layout_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>