<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Low Light Warning Overlay -->
    <LinearLayout
        android:id="@+id/lowLightWarningOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/lowLightWarningIcon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_warning_triangle"
                    android:elevation="6dp" />

                <TextView
                    android:id="@+id/lowLightWarningTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WARNING"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold|italic"
                    android:textSize="28sp"
                    android:background="@drawable/warning_tag_bg"
                    android:paddingStart="32dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginStart="-24dp"
                    android:elevation="2dp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/lowLightWarningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Low\nLighting"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/lowLightWarningSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detection accuracy may be reduced"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Obstruction Warning Overlay -->
    <LinearLayout
        android:id="@+id/obstructionWarningOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/obstructionWarningIcon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_warning_triangle"
                    android:elevation="6dp" />

                <TextView
                    android:id="@+id/obstructionWarningTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WARNING"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold|italic"
                    android:textSize="28sp"
                    android:background="@drawable/warning_tag_bg"
                    android:paddingStart="32dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginStart="-24dp"
                    android:elevation="2dp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/obstructionWarningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMERA\nOBSCURED"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/obstructionWarningSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detection accuracy may be reduced"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Battery Warning Overlay -->
    <LinearLayout
        android:id="@+id/batteryWarningOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/batteryWarningIcon"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_warning_triangle"
                    android:elevation="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WARNING"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold|italic"
                    android:textSize="28sp"
                    android:background="@drawable/warning_tag_bg"
                    android:paddingStart="32dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginStart="-24dp"
                    android:elevation="2dp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/batteryWarningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOW BATTERY\nPERCENTAGE"
            android:textColor="@android:color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/batteryWarningSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please connect to a power source\nto ensure continuous navigation."
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>